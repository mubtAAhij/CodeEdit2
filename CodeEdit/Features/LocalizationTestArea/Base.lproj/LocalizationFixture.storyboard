<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.Storyboard.XIB" version="3.0" toolsVersion="21507" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" colorMatched="YES">
    <scenes>
        <scene sceneID="scene-localization-fixture">
            <objects>
                <viewController id="vc-localization-fixture" sceneMemberID="viewController">
                    <view key="view" id="view-localization-fixture">
                        <subviews>
                            <textField id="title-label" title=String(localized: "localization-fixture.storyboard.title", defaultValue: "Localization Fixture Storyboard", comment: "Title of the localization fixture storyboard")/>
                            <button id="confirm-button" title=String(localized: "localization-fixture.storyboard.confirm-button", defaultValue: "Confirm Changes", comment: "Button to confirm changes in storyboard fixture")/>
                            <button id="discard-button" title=String(localized: "localization-fixture.storyboard.discard-button", defaultValue: "Discard Changes", comment: "Button to discard changes in storyboard fixture")/>
                            <textField id="status-label" title=String(localized: "localization-fixture.storyboard.status-waiting", defaultValue: "Status: Waiting for translation pipeline", comment: "Status message while waiting for translation")/>
                            <textField id="hint-label" title=String(localized: "localization-fixture.storyboard.tip-trigger-pr", defaultValue: "Tip: Trigger a PR run to verify storyboard extraction", comment: "Tip for verifying storyboard extraction")/>
                        </subviews>
                    </view>
                </viewController>
            </objects>
        </scene>
    </scenes>
</document>
