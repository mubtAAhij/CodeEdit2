<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="21507" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES">
    <objects>
        <customView id="fixture-root-view">
            <subviews>
                <textField id="fixture-header" title=String(localized: "localization-fixture.xib.header", defaultValue: "XIB Localization Fixture", comment: "Header label for the XIB localization fixture view")/>
                <textField id="fixture-description" title=String(localized: "localization-fixture.xib.description", defaultValue: "This view contains static labels for localization testing.", comment: "Description explaining the purpose of the XIB fixture view")/>
                <button id="fixture-primary-action" title=String(localized: "localization-fixture.xib.primary-action", defaultValue: "Apply Localization", comment: "Primary action button to apply localization")/>
                <button id="fixture-secondary-action" title=String(localized: "localization-fixture.xib.secondary-action", defaultValue: "Review Differences", comment: "Secondary action button to review localization differences")/>
                <textField id="fixture-footer" title=String(localized: "localization-fixture.xib.footer", defaultValue: "Last run: Not started", comment: "Footer text showing last run status")/>
            </subviews>
        </customView>
    </objects>
</document>
