<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="21507" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES">
    <objects>
        <customView id="fixture-root-view">
            <subviews>
                <textField id="fixture-header" title=String(localized: "localization-fixture.xib.title", defaultValue: "XIB Localization Fixture", comment: "Title of the XIB localization fixture view")/>
                <textField id="fixture-description" title=String(localized: "localization-fixture.xib.description", defaultValue: "This view contains static labels for localization testing.", comment: "Description of the XIB fixture view purpose")/>
                <button id="fixture-primary-action" title=String(localized: "localization-fixture.xib.apply-button", defaultValue: "Apply Localization", comment: "Button to apply localization changes")/>
                <button id="fixture-secondary-action" title=String(localized: "localization-fixture.xib.review-button", defaultValue: "Review Differences", comment: "Button to review localization differences")/>
                <textField id="fixture-footer" title=String(localized: "localization-fixture.xib.last-run-status", defaultValue: "Last run: Not started", comment: "Status message for last localization run")/>
            </subviews>
        </customView>
    </objects>
</document>
